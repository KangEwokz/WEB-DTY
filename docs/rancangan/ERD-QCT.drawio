ge="1" parent="1" source="t_abnormal" target="t_karyawan"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="473.0"/><mxPoint x="925" y="30"/><mxPoint x="456.0" y="30"/></Array></mxGeometry></mxCell><mxCell id="e24" value="insp_visual, insp_lab" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;entryX=0.5;entryY=0;html=1;endArrow=ERmandOne;endFill=0;startArrow=ERzeroToMany;startFill=0;endSize=10;startSize=10;fontSize=9;strokeColor=#999999;fontColor=#777777;" edge="1" parent="1" source="t_sampel" target="t_karyawan"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="823.0"/><mxPoint x="925" y="30"/><mxPoint x="456.0" y="30"/></Array></mxGeometry></mxCell><mxCell id="e25" value="created_by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;entryX=0.5;entryY=0;html=1;endArrow=ERmandOne;endFill=0;startArrow=ERzeroToMany;startFill=0;endSize=10;startSize=10;fontSize=9;strokeColor=#999999;fontColor=#777777;" edge="1" parent="1" source="t_doffing" target="t_karyawan"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="1386.0" y="30"/><mxPoint x="456.0" y="30"/></Array></mxGeometry></mxCell><mxCell id="e26" value="created_by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;entryX=0.5;entryY=0;html=1;endArrow=ERmandOne;endFill=0;startArrow=ERzeroToMany;startFill=0;endSize=10;startSize=10;fontSize=9;strokeColor=#999999;fontColor=#777777;" edge="1" parent="1" source="t_jadwal_produksi" target="t_karyawan"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="1562" y="413.0"/><mxPoint x="1562" y="30"/><mxPoint x="456.0" y="30"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;Biru = data pendukung Admin &amp;amp; master umum (area dipakai semua divisi) · Hijau = data pendukung Produksi · Oranye = QCT&lt;br&gt;PK primary key · FK foreign key · UQ unik&lt;br&gt;Garis abu-abu = kolom petugas/verifikator/penginput yang merujuk ke karyawan&lt;br&gt;Tanggal/shift/troly/merge pada check_batch &amp;amp; abnormal diambil lewat id_doffing (tidak disimpan ulang).&lt;br&gt;Role: direktur, hod, supervisor, staf, operator. Akses menu = role + divisi + area (area dari absensi shift, cadangan karyawan.id_area).&lt;br&gt;laporan_check &amp; rekap_check hanya menyimpan status verifikasi; angkanya dihitung dari check_batch, abnormal, sampel." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#BBBBBB;fillColor=#FAFAFA;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="820" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>